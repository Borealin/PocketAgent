+static int pocket_process_init(struct subprocess_info *info, struct cred *new) {
+    struct pocket_process *process = info->data;
+    kuid_t uid = KUIDT_INIT(process->uid);
+    kgid_t gid = KGIDT_INIT(process->uid);
+    new->uid = new->euid = new->suid = new->fsuid = uid;
+    new->gid = new->egid = new->sgid = new->fsgid = gid;
+    new->cap_inheritable = new->cap_permitted = new->cap_effective = CAP_EMPTY_SET;
+    new->cap_bset = new->cap_ambient = CAP_EMPTY_SET;
+    task_set_no_new_privs(current);
+    int err = ksys_setsid();
+    if (err < 0)
+        return err;
+    // Standard streams start on /dev/null, so the first file the script
+    // opens never becomes fd 0-2 (best effort: the wrapper redirects too).
+    struct file *null = filp_open("/dev/null", O_RDWR, 0);
+    if (!IS_ERR(null)) {
+        for (int fd = 0; fd <= 2; fd++)
+            replace_fd(fd, null, 0);
+        fput(null);
+    }
+    process->pid = task_pid_nr(current);
+    return 0;
+}
+
+void pocket_run_process(const char *const *argv, const char *const *envp, int uid, PocketProcessDone done) {
+    struct pocket_process *process = kzalloc(sizeof(*process), GFP_KERNEL);
+    if (process == NULL) {
+        done(-ENOMEM, 0);
+        return;
+    }
+    process->uid = uid;
+    struct subprocess_info *info = call_usermodehelper_setup(argv[0], (char **) argv, (char **) envp,
+                                                             GFP_KERNEL, pocket_process_init, NULL, process);
+    int status = info == NULL ? -ENOMEM : call_usermodehelper_exec(info, UMH_WAIT_PROC);
+    int pid = process->pid;
+    kfree(process);
+    done(status, pid);
+}
+
+int pocket_user_tasks(int uid, int sig) {
+    struct task_struct *task;
+    int count = 0;
+    struct task_struct *thread;
+    rcu_read_lock();
+    // Every thread is examined: a process whose leader already exited can
+    // still have live threads. send_sig() targets the whole thread group.
+    for_each_process_thread(task, thread) {
+        if ((thread->flags & PF_KTHREAD) || thread->exit_state)
+            continue;
+        if (!uid_eq(task_uid(thread), KUIDT_INIT(uid)))
+            continue;
+        count++;
+        if (sig > 0)
+            send_sig(sig, thread, 1);
+    }
+    rcu_read_unlock();
+    return count;
+}
