+int pocket_mount_workspace(const char *host_directory, const char *mount_point) {
+    if (host_directory == NULL || mount_point == NULL || host_directory[0] != '/' || mount_point[0] != '/')
+        return -EINVAL;
+    size_t length = strnlen(host_directory, PAGE_SIZE);
+    if (length == PAGE_SIZE)
+        return -ENAMETOOLONG;
+    // path_mount() treats the data argument as a whole writable page.
+    char *page = kzalloc(PAGE_SIZE, GFP_KERNEL);
+    if (page == NULL)
+        return -ENOMEM;
+    memcpy(page, host_directory, length);
+    int err = do_mount("pocketagent", mount_point, "hostfs", MS_SILENT | MS_NOSUID | MS_NODEV, page);
+    kfree(page);
+    return err;
+}
+
+int pocket_unmount_workspace(const char *mount_point) {
+    return init_umount(mount_point, MNT_DETACH);
+}
