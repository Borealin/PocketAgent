+/* PocketAgent: run_kernel without the unbounded wait. The boot thread uses
+ * only static state (init_task and its stack, boot_command_line), so it can
+ * keep running, or never finish, after the caller stopped waiting; the caller
+ * then treats the kernel as unusable. 0 once started, nonzero otherwise. */
+extern int wait_for_startup_bounded(unsigned seconds);
+int run_kernel_bounded(unsigned seconds)
+{
+	setup_current();
+	if (start_cpu_thread(0, (void *) start_main, &init_task, task_stack_page(&init_task), THREAD_SIZE) != 0)
+		return -1;
+	return wait_for_startup_bounded(seconds);
+}
