+
+/* PocketAgent: a kernel panic ends a bounded wait at once. */
+static bool startup_failed = false;
+void pocket_startup_failed(void) {
+	pthread_mutex_lock(&status_lock);
+	startup_failed = true;
+	pthread_cond_broadcast(&status_cond);
+	pthread_mutex_unlock(&status_lock);
+}
+
+/* PocketAgent: wait_for_startup with a bound. Returns 0 once the kernel has
+ * reached its late initcalls, -1 if it has not after `seconds` or panicked. */
+int wait_for_startup_bounded(unsigned seconds) {
+	struct timespec deadline;
+	clock_gettime(CLOCK_REALTIME, &deadline);
+	deadline.tv_sec += seconds;
+	pthread_mutex_lock(&status_lock);
+	int err = 0;
+	while (!started && !startup_failed && err != ETIMEDOUT)
+		err = pthread_cond_timedwait(&status_cond, &status_lock, &deadline);
+	bool done = started;
+	pthread_mutex_unlock(&status_lock);
+	return done ? 0 : -1;
+}
