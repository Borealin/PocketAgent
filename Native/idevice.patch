+/// Launches a preinstalled test runner with the DVT background activation option.
+///
+/// # Safety
+/// The handle and output PID must be valid. Environment entries must be valid
+/// NUL-terminated strings, and the array must contain env_vars_count entries.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn process_control_launch_test_runner(
+    handle: *mut ProcessControlHandle<'static>,
+    bundle_id: *const c_char,
+    env_vars: *const *const c_char,
+    env_vars_count: usize,
+    pid: *mut u64,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || bundle_id.is_null() || pid.is_null()
+        || (env_vars_count != 0 && env_vars.is_null())
+    {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let bundle_id = match unsafe { CStr::from_ptr(bundle_id) }.to_str() {
+        Ok(value) => value.to_owned(),
+        Err(_) => return ffi_err!(IdeviceError::FfiInvalidArg),
+    };
+    let mut env = Dictionary::new();
+    if env_vars_count != 0 {
+        for &entry in unsafe { std::slice::from_raw_parts(env_vars, env_vars_count) } {
+            if entry.is_null() {
+                return ffi_err!(IdeviceError::FfiInvalidArg);
+            }
+            let value = match unsafe { CStr::from_ptr(entry) }.to_str() {
+                Ok(value) => value,
+                Err(_) => return ffi_err!(IdeviceError::FfiInvalidArg),
+            };
+            let Some((key, value)) = value.split_once('=') else {
+                return ffi_err!(IdeviceError::FfiInvalidArg);
+            };
+            env.insert(key.to_owned(), Value::String(value.to_owned()));
+        }
+    }
+    let client = unsafe { &mut (*handle).0 };
+    let mut options = Dictionary::new();
+    options.insert("StartSuspendedKey".into(), Value::Boolean(false));
+    options.insert("KillExisting".into(), Value::Boolean(true));
+    options.insert("ActivateSuspended".into(), Value::Boolean(true));
+    let result = run_sync(async move {
+        client.launch_with_options(bundle_id, env, Vec::new(), options).await
+    });
+    match result {
+        Ok(value) => {
+            unsafe { *pid = value; }
+            null_mut()
+        }
+        Err(error) => ffi_err!(error),
+    }
+}
