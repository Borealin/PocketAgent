+/// Frees both the installed application plists and their pointer array.
+///
+/// # Safety
+/// `apps` must be NULL or an unfreed array returned by
+/// `application_listing_get_apps`, with its original `count`. Borrowed child
+/// nodes and strings must no longer be used. Do not pass arrays from other APIs.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn application_listing_free_apps(apps: *mut plist_t, count: usize) {
+    if apps.is_null() {
+        return;
+    }
+    let apps = unsafe { Box::from_raw(std::ptr::slice_from_raw_parts_mut(apps, count)) };
+    for app in apps.iter() {
+        unsafe { plist_ffi::creation::plist_free(*app as *mut PlistWrapper) };
+    }
+    // The owned boxed slice drops its allocation after all plists are freed.
+}
