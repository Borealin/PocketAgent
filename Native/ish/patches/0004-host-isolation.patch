+/* PocketAgent egress policy. Every guest TCP connection, UDP datagram and
+ * ping leaves the GOLP device through host_connect/host_sendmsg in this file.
+ * Loopback (where the WebDriverAgent listener lives), private, link-local,
+ * CGNAT, multicast and broadcast destinations are refused regardless of guest
+ * privileges, and so is every address in the host-supplied list: the phone's
+ * own interface addresses (WebDriverAgent listens on all interfaces, so a
+ * public address assigned to the phone also reaches it) and the tunnel
+ * address. Ports 8100 (WebDriverAgent) and 62078 (lockdown) are refused on
+ * every destination, so a phone address that is not in the list yet (it is
+ * refreshed about once a second) still cannot reach those listeners. Both the
+ * Linux and Darwin IPv4 sockaddr layouts keep the port at offset 2 and the
+ * address at offset 4, network byte order. */
+#define POCKET_BLOCKED_MAX 32
+static _Atomic uint32_t pocket_blocked[POCKET_BLOCKED_MAX];
+void pocket_set_blocked_hosts(const uint32_t *addresses_network_order, unsigned count)
+{
+	for (unsigned i = 0; i < POCKET_BLOCKED_MAX; i++)
+		pocket_blocked[i] = i < count ? addresses_network_order[i] : 0;
+}
